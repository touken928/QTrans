[settings]
os=Windows
arch=x86_64
build_type=Release
# clang-cl deliberately uses Conan's MSVC model: it produces the MSVC ABI and
# links against the MSVC static runtime, so it can consume compatible packages.
compiler=msvc
compiler.version=195
compiler.cppstd=17
compiler.runtime=static
compiler.runtime_type=Release

[conf]
tools.build:compiler_executables={"c":"clang-cl", "cpp":"clang-cl"}
tools.cmake.cmaketoolchain:generator=Ninja
tools.cmake.cmaketoolchain:extra_variables={"CMAKE_LINKER_TYPE":"LLD"}
