{
  "name": "qtrans",
  "version-string": "0.1.0",
  "dependencies": [
    {
      "name": "llama-cpp",
      "features": [
        "vulkan"
      ],
      "platform": "windows & x64 & !arm64"
    },
    {
      "name": "llama-cpp",
      "platform": "!windows | (windows & arm64)"
    },
    {
      "name": "curl",
      "features": [
        "ssl"
      ]
    },
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "gui",
        "widgets",
        "network",
        "png"
      ]
    },
    "gtest",
    {
      "name": "icu",
      "platform": "!windows"
    },
    "simdutf",
    "spdlog"
  ]
}
