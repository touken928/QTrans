{
  "$comment": "Shared public presets require VCPKG_ROOT from the environment; do not add machine-specific paths.",
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 3,
    
    "minor": 31,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "arm64-osx-release",
      "displayName": "macOS ARM64 Clang (Release)",
      "description": "Release build for macOS ARM64 using Clang.",
      "$comment": "Requires VCPKG_ROOT in the environment and an arm64 macOS toolchain.",
      "inherits": "base",
      "cacheVariables": {
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/macos-arm64.cmake",
        "VCPKG_TARGET_TRIPLET": "arm64-osx-release",
        "VCPKG_HOST_TRIPLET": "arm64-osx-release"
      }
    },
    {
      "name": "x64-msvc-static-release",
      "displayName": "MSVC x64 static (Release)",
      "description": "Release build for Windows x64 using MSVC and the static CRT.",
      "inherits": "base",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-release-noicu",
        "VCPKG_HOST_TRIPLET": "x64-windows-static-release-noicu",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "arm64-osx-release",
      "displayName": "macOS arm64 (Release)",
      "configurePreset": "arm64-osx-release"
    },
    {
      "name": "x64-msvc-static-release",
      "displayName": "MSVC x64 static (Release)",
      "configurePreset": "x64-msvc-static-release"
    }
  ]
}
