{
  "$comment": "Run the matching conan install command before configuring a public preset.",
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "arm64-osx-release",
      "displayName": "macOS ARM64 Clang (Release)",
      "description": "Release build for macOS ARM64 using Clang.",
      "$comment": "Requires ../build/arm64-osx-release/conan/conan_toolchain.cmake.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/../build/arm64-osx-release/conan/conan_toolchain.cmake",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "x64-clangcl-static-release",
      "displayName": "clang-cl x64 static (Release)",
      "description": "Release build for Windows x64 using clang-cl, lld-link, the MSVC ABI, and the static CRT.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/../build/x64-clangcl-static-release/conan/conan_toolchain.cmake",
        "CMAKE_LINKER_TYPE": "LLD",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "arm64-osx-release",
      "displayName": "macOS arm64 (Release)",
      "configurePreset": "arm64-osx-release"
    },
    {
      "name": "x64-clangcl-static-release",
      "displayName": "clang-cl x64 static (Release)",
      "configurePreset": "x64-clangcl-static-release"
    }
  ]
}
